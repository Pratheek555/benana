{
  "name": "benana-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop coding-agent workspace with repository context, verified attempts, and reviewed recovery.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c yellow,gray \"vite\" \"wait-on tcp:127.0.0.1:5199 && node scripts/dev-electron.cjs\"",
    "build": "vite build",
    "test": "node --test",
    "smoke:desktop": "npm run build && electron scripts/desktop-smoke.cjs",
    "start": "vite build && electron .",
    "mcp": "node electron/mcp-server.cjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "cytoscape": "^3.30.2",
    "dotenv": "^16.4.5",
    "mineflayer": "^4.39.0",
    "mineflayer-pathfinder": "^2.4.5",
    "prismarine-viewer": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.21.5": true
  }
}
