{
  "name": "benana-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Benana: a self-improving coding-agent harness built around an intent graph.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c yellow,gray \"vite\" \"wait-on tcp:127.0.0.1:5199 && cross-env BENANA_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "mcp": "node electron/mcp-server.cjs"
  },
  "dependencies": {
    "cytoscape": "^3.30.2",
    "dotenv": "^16.4.5",
    "neatlogs": "^1.1.28",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.21.5": true
  }
}
