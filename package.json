{
  "name": "benana-harness",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop coding-agent workspace with repository context, verified attempts, and reviewed recovery.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c yellow,gray \"vite\" \"wait-on tcp:127.0.0.1:5199 && cross-env BENANA_DEV=1 electron .\"",
    "build": "vite build",
    "test": "node --test",
    "smoke:desktop": "npm run build && electron scripts/desktop-smoke.cjs",
    "start": "vite build && electron .",
    "mcp": "node electron/mcp-server.cjs"
  },
  "dependencies": {
    "cytoscape": "^3.34.3",
    "dotenv": "^18.0.7",
    "neatlogs": "^1.1.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "44.7.0",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.21.5": true
  }
}
