# Cloudflare API token for Artifacts (intent/harness repos, forks)
CLOUDFLARE_API_TOKEN=
# Cloudflare account id (optional; derived from token otherwise)
CLOUDFLARE_ACCOUNT_ID=
# Artifacts namespace (default benana-dev)
ARTIFACTS_NAMESPACE=
# GitHub token (optional; falls back to `gh auth token`)
GITHUB_TOKEN=
# Neatlogs SDK project key: exports agent-run traces (tracing.cjs)
NEATLOGS_API_KEY=
# Neatlogs ingest endpoint (default https://ingest.neatlogs.com)
NEATLOGS_ENDPOINT=
# Neatlogs service-account token: lets the L4 analyst read traces back (optional)
NEATLOGS_TOKEN=
# Neatlogs project id
NEATLOGS_PROJECT_ID=
# Neatlogs region, e.g. eu (optional)
NEATLOGS_REGION=
# Local data directory (default ~/.benana)
BENANA_DATA_DIR=
