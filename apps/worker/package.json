{
  "name": "@benana/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint src vite.config.ts vitest.config.ts --max-warnings 0",
    "test": "vitest run",
    "preview": "$npm_execpath run build && vite preview",
    "deploy": "$npm_execpath run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@benana/contracts": "workspace:*",
    "hono": "^4.13.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@eslint/js": "9.37.0",
    "@types/node": "^24.10.0",
    "eslint": "9.37.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "^8.1.4",
    "vite-ssr-components": "^0.8.0",
    "vitest": "3.2.4",
    "wrangler": "^4.110.0"
  }
}
